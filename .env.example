# Copy to .env.local:  Copy-Item .env.example .env.local   (PowerShell)
# The app runs fully WITHOUT any of these (local demo mode).
# NEVER commit .env.local or put real keys in this file.

# --- Optional: Supabase cloud persistence (server-side only) ---
# Project URL and SERVICE ROLE key from Supabase > Project Settings > API.
# The service-role key bypasses RLS: keep it server-side, never prefix it with NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Optional: Google Safe Browsing (external threat intelligence) ---
# If set, the submitted URL (string only, never fetched) is sent to Google Safe Browsing.
SAFE_BROWSING_API_KEY=

# --- Optional: local demo data directory (default: ./.data) ---
# OPPORTUNITYSHIELD_DATA_DIR=.data
